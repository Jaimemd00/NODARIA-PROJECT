# ------------------------------------------------------------------
# CORREO DEL FORMULARIO  (elige UNA opción; la 1 es la recomendada)
# ------------------------------------------------------------------

# Dónde llegan los mensajes
CONTACT_TO=nodariatech@gmail.com

# --- Opción 1: Gmail por SMTP (funciona hoy, sin dominio propio) ---
# Necesitas una "Contraseña de aplicación" de Google, NO la contraseña normal.
# Pasos en el README.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nodariatech@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Opción 2: Resend (mejor entregabilidad, requiere dominio verificado) ---
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Web Nodaria <hola@nodaria.com>

# --- Opción 3: webhook de n8n (si preferís procesarlo en vuestro flujo) ---
# N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/contacto-web

# ------------------------------------------------------------------
# SEO
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nodaria.com
